# Copy this file to .env and fill in values as needed.
# .env is git-ignored. Never commit real secrets.

# --- Core server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- AI provider (backend-only — never expose these to the frontend) ---
# Leave these blank to run CodeMentor in local-only mode. The app is
# designed to start successfully and work well with no AI key at all.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_TIMEOUT_MS=30000

# --- AI fair-use / low-cost policy ---
AI_DAILY_LIMIT=3
AI_COOLDOWN_SECONDS=30
AI_CACHE_TTL_SECONDS=86400
AI_MAX_SOURCE_CHARS=12000
AI_MAX_CONTEXT_LINES=80

# --- Local code execution limits ---
RUN_TIMEOUT_MS=3000
MAX_CODE_SIZE_BYTES=51200
MAX_STDIN_SIZE_BYTES=10240
